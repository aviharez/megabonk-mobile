<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline enemy sprite exporter. Compiles the engine-independent Core of procedural-pixel-creatures
    (MIT) straight from its checkout; nothing from the generator is copied into this repository.
    Override the checkout location with: dotnet run -p:PpcRoot=/path/to/procedural-pixel-creatures ...
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>CreatureExport</RootNamespace>
    <AssemblyName>creature_export</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PpcRoot Condition="'$(PpcRoot)' == ''">$(HOME)/Documents/Playgrounds/tools/procedural-pixel-creatures</PpcRoot>
  </PropertyGroup>
  <Target Name="CheckPpcRoot" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PpcRoot)/addons/procedural_creatures/Core')"
           Text="procedural-pixel-creatures Core not found at '$(PpcRoot)'. Pass -p:PpcRoot=/path/to/procedural-pixel-creatures." />
  </Target>
  <ItemGroup>
    <Compile Include="$(PpcRoot)/addons/procedural_creatures/Core/**/*.cs" LinkBase="PpcCore" />
  </ItemGroup>
</Project>
