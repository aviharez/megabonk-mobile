; Engine configuration file.
; See docs/BRIEF.md "Godot settings" and CLAUDE.md "Technical rules".

config_version=5

[application]

config/name="Swarm Survivor Pixel"
config/description="Pixel survivor-like for mobile (working title)."
config/version="0.0.1"
run/main_scene="res://scenes/main_menu.tscn"
; The "Android Stress" export preset (feature tag "stress") boots into the stress test.
run/main_scene.stress="res://scenes/debug/bot_run.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon/icon.png"
boot_splash/bg_color=Color(0.0549, 0.0431, 0.0863, 1)
boot_splash/show_image=false

[admob]

; Poing AdMob plugin settings. All listed so the plugin never needs to
; re-save this file. App ids are Google's public TEST ids (docs/PLUGINS.md);
; real ids only with the owner's OK. No mediation adapters are vendored.
general/android/enabled=true
general/android/app_id="ca-app-pub-3940256099942544~3347511713"
general/android/enable_r8_optimization=false
general/android/disable_initialization_optimization=false
general/android/disable_ad_loading_optimization=false
general/ios/enabled=true
general/ios/app_id="ca-app-pub-3940256099942544~1458002511"
mediation/applovin=false
mediation/bidmachine=false
mediation/chartboost=false
mediation/dtexchange=false
mediation/imobile=false
mediation/inmobi=false
mediation/ironsource=false
mediation/line=false
mediation/maio=false
mediation/meta=false
mediation/mintegral=false
mediation/moloco=false
mediation/mytarget=false
mediation/pangle=false
mediation/pubmatic=false
mediation/unity_ads=false
mediation/vungle=false

[autoload]

Save="*res://scripts/autoload/save_manager.gd"
Ads="*res://scripts/autoload/ads.gd"
Store="*res://scripts/autoload/store.gd"

[display]

window/size/viewport_width=180
window/size/viewport_height=320
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
; 180x320 is the minimum view; taller (or wider) screens see more, still at integer scale.
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg", "res://addons/GodotGooglePlayBilling/plugin.cfg")

[gui]

theme/custom="res://assets/ui/theme.tres"
theme/default_font_antialiasing=0
theme/default_font_hinting=0
common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.0549, 0.0431, 0.0863, 1)
textures/vram_compression/import_etc2_astc=true
